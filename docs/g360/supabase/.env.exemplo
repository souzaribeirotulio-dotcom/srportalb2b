# Preencha os segredos no ambiente da função.
G360_BASE_URL=https://homologacao.example.invalid
G360_LOJA=<preencha>
G360_CHAVE_SISTEMA=<preencha>
# Janela máxima do vínculo para os dados privados do Supabase, em minutos.
G360_RECONFERENCIA_MINUTOS=5
# Segredo aleatório separado, com pelo menos 32 bytes, para deduplicar ocorrências.
G360_OCORRENCIAS_HMAC=<preencha>
PORTAL_ORIGENS=https://portal.example.invalid,https://portal-homologacao.example.invalid,http://localhost:5173
PORTAL_PAGINA_SENHA=https://portal.example.invalid/definir-senha
EMAIL_ENDPOINT=https://email.example.invalid/enviar
EMAIL_CHAVE=<preencha>

# O runtime do Supabase fornece SUPABASE_URL e SUPABASE_SECRET_KEYS.
# Use a chave secreta moderna default do projeto.
