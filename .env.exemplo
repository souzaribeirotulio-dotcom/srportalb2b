# Variáveis PÚBLICAS do portal (vão para o navegador). Nunca coloque segredos aqui.
# Copie para ".env.local" para rodar no computador, ou cadastre na Vercel
# (Projeto > Settings > Environment Variables).

# URL-base da API, sem barra no fim e sem /b2b/v1
VITE_G360_BASE_URL=
# Slug da loja: 16 caracteres hexadecimais minúsculos
VITE_G360_LOJA=
# Supabase (Etapa 3): endereço do projeto e chave PÚBLICA (publishable ou anon)
VITE_SUPABASE_URL=
VITE_SUPABASE_CHAVE_PUBLICA=
# Endereço da função ponte-g360 (Etapa 3)
VITE_PONTE_URL=
